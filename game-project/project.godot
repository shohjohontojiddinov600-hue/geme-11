; Engine configuration file for Mythic Realms (Capstone Project)
; It's best edited using the editor UI and not directly,
; but since the parameters are simple, you can edit this file directly.

config_version=5

[application]

config/name="Mythic Realms — 2D Multiplayer Survival Sandbox"
config/description="Capstone 12-loyiha: 2D ko'p o'yinchili survival, crafting va persistent sandbox o'yini"
config/version="1.0.0"
run/main_scene="res://scenes/levels/game.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://assets/sprites/icon.svg"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=0
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

